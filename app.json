{
  "expo": {
    "name": "KlokShift",
    "slug": "topWaitr",
    "owner": "tiaxd94",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "klokshift",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.klokshift.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.klokshift.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0C0907",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0907",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Consenti a KlokShift di salvare il tuo QR nella galleria.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Consenti a KlokShift di accedere alle foto per scegliere l'immagine del tuo profilo."
        }
      ],
      "@sentry/react-native",
      "expo-sharing",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fb0c5607-9c6a-48be-9ceb-be4c684058b3"
      }
    }
  }
}
