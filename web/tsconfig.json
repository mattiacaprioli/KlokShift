{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "incremental": true,
    "tsBuildInfoFile": "../.expo/cache/tsconfig.web.tsbuildinfo",
    "paths": {
      "@/lib/supabase": ["./src/lib/supabase.ts"],
      "@/features/push/api": ["./src/lib/pushStub.ts"],
      "@/features/venues/activeVenueStorage": [
        "./src/lib/activeVenueStorage.ts"
      ],
      "@/*": ["../src/*"]
    }
  },
  "include": ["src", "vite.config.mts"]
}
