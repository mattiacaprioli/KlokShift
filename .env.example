# Variabili del client (app, dashboard e sito). Copia in `.env` e riempi:
# solo nomi qui, mai valori. Per le build EAS vanno impostate su EAS, perché
# il `.env` non arriva alla build.

# Obbligatorie
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Facoltative (con un ripiego nel codice o spente se vuote)
EXPO_PUBLIC_SITE_URL=
EXPO_PUBLIC_APP_URL=
EXPO_PUBLIC_IOS_URL=
EXPO_PUBLIC_ANDROID_URL=
EXPO_PUBLIC_SENTRY_DSN=
