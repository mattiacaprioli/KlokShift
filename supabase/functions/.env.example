# Segreti delle Edge Functions: solo nomi, mai valori. In produzione si
# impostano con `supabase secrets set` (vedi supabase/README.md, «Deploy Edge
# Functions»). SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY li
# fornisce l'ambiente Edge del progetto.

# invite-staff
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SITE_URL=
DASHBOARD_URL=

# push
PUSH_HOOK_SECRET=
EXPO_ACCESS_TOKEN=
